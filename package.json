{
  "name": "vite_react_shadcn_ts",
  "private": true,
  "version": "0.0.0",
  "type": "module",
  "scripts": {
    "dev": "vite",
    "build": "vite build",
    "build:dev": "vite build --mode development",
    "lint": "eslint .",
    "type-check": "tsc -p tsconfig.app.json --noEmit",
    "preview": "vite preview",
    "test": "vitest run",
    "test:watch": "vitest",
    "test:edge": "cd supabase/functions && cross-env DENO_TEST_SUPABASE_REMOTE=0 deno task test:ci",
    "test:edge:remote": "node scripts/with-preview-env.mjs supabase/functions cross-env DENO_TEST_SUPABASE_REMOTE=1 deno task test:remote",
    "test:e2e": "playwright test",
    "test:e2e:xdev": "playwright test --grep @xdev",
    "test:e2e:prod": "playwright test --config=playwright.prod.config.ts",
    "test:quarantine": "vitest run --dir src/test/quarantine",
    "verify:costing-telemetry": "node scripts/verify-costing-telemetry.mjs",
    "verify:baseline": "npm run lint && npm run type-check && npm run test && npm run test:edge && npm run test:edge:remote && npm run test:e2e && npm run build",
    "test:adversarial": "promptfoo eval --config supabase/functions/interview-prep-analyze/__tests__/fixtures/injection/promptfooconfig.yaml",
    "test:adversarial:resume": "promptfoo eval --config supabase/functions/analyze-resume/__tests__/fixtures/injection/promptfooconfig.yaml",
    "test:adversarial:career": "promptfoo eval --config supabase/functions/analyze-career/__tests__/fixtures/injection/promptfooconfig.yaml",
    "test:adversarial:linkedin": "promptfoo eval --config supabase/functions/grade-linkedin/__tests__/fixtures/injection/promptfooconfig.yaml",
    "test:adversarial:linkedin-distribution": "promptfoo eval --config supabase/functions/grade-linkedin/__tests__/fixtures/injection/promptfooconfig.linkedin-distribution.yaml",
    "test:adversarial:recruiting": "promptfoo eval --config supabase/functions/recruiting-lens/__tests__/fixtures/injection/promptfooconfig.yaml",
    "audit:deadcode": "node scripts/audit/run-deadcode.mjs",
    "audit:deps": "node scripts/audit/run-deps.mjs",
    "audit": "npm run audit:deadcode && npm run audit:deps"
  },
