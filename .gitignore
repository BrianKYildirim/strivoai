# Environment variables (secrets — never commit)
.env
.env.*
!.env.example
!.env.test.local.example

# Logs
logs
*.log
npm-debug.log*
yarn-debug.log*
yarn-error.log*
pnpm-debug.log*
lerna-debug.log*

node_modules
dist
dist-ssr
*.local

# Stale/alternate Vite build output (never served; Vercel builds its own dist)
dist-codex/

# Supabase CLI machine-local link state (flips per `supabase link`; not shared config)
supabase/.temp/

# Claude Code agent worktrees (live, ephemeral)
.claude/worktrees/

# Playwright / E2E test output (can contain real session tokens — never commit)
.auth/
test-results/
playwright-report/
e2e/.cache/
.playwright-cli/

# Editor directories and files
.vscode/*
!.vscode/extensions.json
.idea
.DS_Store
*.suo
*.ntvs*
*.njsproj
*.sln
*.sw?
.vercel
.env*
